    <string name="guide_combo_refill_title">Combo hồi lượt xoay</string>
    <string name="guide_combo_refill_desc">Combo ×2 trở lên → +1 lượt xoay (combo dài hồi càng nhiều)</string>
    <string name="guide_combo_refill_body">Xóa [p]combo ×2[/p] trở lên\nđược [g]+1 lượt xoay[/g].\nCombo càng dài\nlượt hồi càng nhiều!</string>

    <string name="guide_clear_line_title">Xóa hàng / cột</string>
    <string name="guide_clear_line_desc">Lấp đầy 1 hàng hoặc cột → biến mất + điểm</string>
    <string name="guide_clear_line_body">Lấp đầy một [p]HÀNG hoặc CỘT[/p]\n(9 ô bất kỳ màu)\n→ cả hàng/cột [g]biến mất[/g]\nvà được tính điểm.</string>

    <string name="guide_gravity_rotate_title">Xoay trọng lực</string>
    <string name="guide_gravity_rotate_desc">Đổi hướng trọng lực 90°; D-Pad chỉ hướng, cả cụm đổ theo</string>
    <string name="guide_gravity_rotate_body">Nhấn [g]nút xoay[/g] để đổi\nhướng trọng lực 90°.\n[p]D-Pad[/p] hiện hướng hiện tại\n— cả cụm khối đổ theo!</string>

    <string name="guide_gravity_drop_title">Trọng lực rơi</string>
    <string name="guide_gravity_drop_desc">Khối rơi xuống, dừng khi gặp khối khác / đáy</string>
    <string name="guide_gravity_drop_body">Sau khi xóa, các khối\nphía trên [g]RƠI XUỐNG[/g]\n— dừng lại ngay khi\ngặp [p]khối khác / đáy[/p].</string>

    <string name="guide_sticky_cluster_title">Thạch dính</string>
    <string name="guide_sticky_cluster_desc">Thạch cùng màu dính thành cụm; 1 ô bị chặn → cả cụm dừng</string>
    <string name="guide_sticky_cluster_body">Thạch [p]CÙNG MÀU[/p] chạm nhau\nthì DÍNH thành một khối.\nMột thạch bị chặn\n→ [g]cả khối dừng lại[/g]!</string>

    <string name="guide_form_super1_title">Thạch Hoàng Gia</string>
    <string name="guide_form_super1_desc">Lấp 1 hàng / cột / khối 3×3 cùng màu → Thạch Hoàng Gia</string>
    <string name="guide_form_super1_body">Lấp đầy 1 hàng, 1 cột,\nhoặc khối 3×3 [p]CÙNG MÀU[/p]\n→ tạo một [g]THẠCH HOÀNG GIA[/g]\nsáng lấp lánh!</string>

    <string name="guide_form_rainbow_title">Thạch Cầu Vồng</string>
    <string name="guide_form_rainbow_desc">3×3 đủ ba màu (mỗi màu 1 hàng / cột) → Thạch Cầu Vồng</string>
    <string name="guide_form_rainbow_body">Xếp 3×3 đủ [p]BA MÀU[/p]\n(mỗi màu một hàng/cột)\n→ tạo [g]THẠCH CẦU VỒNG[/g].</string>

    <string name="guide_form_super2_title">Vua Thạch</string>
    <string name="guide_form_super2_desc">Ghép 2 Thạch Hoàng Gia cùng màu dính nhau → Vua Thạch</string>
    <string name="guide_form_super2_body">Ghép hai Thạch Hoàng Gia\n[p]CÙNG MÀU[/p] dính nhau\n→ lên [g]VUA THẠCH[/g]\nmạnh hơn nhiều!</string>

    <string name="guide_form_rainbow2_title">Hoàng Đế Cầu Vồng</string>
    <string name="guide_form_rainbow2_desc">Ghép 2 khối giải phóng khác màu → Hoàng Đế Cầu Vồng (đội vương miện)</string>
    <string name="guide_form_rainbow2_body">Ghép hai khối giải phóng\n[p]KHÁC MÀU[/p] dính nhau\n→ [g]HOÀNG ĐẾ CẦU VỒNG[/g]\nđội vương miện!</string>

    <string name="guide_detonate_super1_title">Giải phóng Thạch Hoàng Gia</string>
    <string name="guide_detonate_super1_desc">Cuốn vào hàng / cột bị xóa → quét sạch mọi ô cùng màu</string>
    <string name="guide_detonate_super1_body">Cuốn Thạch Hoàng Gia vào\nmột hàng/cột bị xóa\nsẽ giải phóng, quét sạch\n[g]MỌI Ô CÙNG MÀU[/g] trên bàn!</string>

    <string name="guide_detonate_super2_title">Giải phóng Vua Thạch</string>
    <string name="guide_detonate_super2_desc">Quét cùng màu + cả vùng 5×5 quanh tâm</string>
    <string name="guide_detonate_super2_body">Vua Thạch giải phóng:\nquét sạch cùng màu\n+ cả [g]vùng 5×5[/g]\nquanh tâm!</string>

    <string name="guide_detonate_rainbow1_title">Giải phóng Thạch Cầu Vồng</string>
    <string name="guide_detonate_rainbow1_desc">Quét sạch mọi ô thuộc các màu đang KỀ nó</string>
    <string name="guide_detonate_rainbow1_body">Thạch Cầu Vồng giải phóng:\nquét sạch mọi ô thuộc\n[g]các MÀU đang KỀ[/g] nó.</string>

    <string name="guide_detonate_rainbow2_title">Giải phóng Hoàng Đế Cầu Vồng</string>
    <string name="guide_detonate_rainbow2_desc">Kỹ năng tối thượng: xóa sạch TOÀN BÀN (kể cả đá)</string>
    <string name="guide_detonate_rainbow2_body">Kỹ năng tối thượng:\nHoàng Đế Cầu Vồng giải phóng\n→ [g]XÓA SẠCH TOÀN BÀN[/g]\n(kể cả đá)!</string>

