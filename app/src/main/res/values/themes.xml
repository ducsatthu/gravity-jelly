<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Theme nền cho Activity trước khi Compose dựng. Màu nền = bg kem #FFF7EC. -->
    <style name="Theme.GravityJelly" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/gj_bg</item>
        <item name="android:statusBarColor">@color/gj_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Splash hệ thống (androidx.core SplashScreen, backport tới API 24): nền KEM + logo mới.
         Nền splash = nền game → Compose dựng frame đầu không "nhảy" màu. -->
    <style name="Theme.GravityJelly.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/gj_splash_cream</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <!-- Logo chữ mới (home_logo resize) ở đáy splash. API 31+ (Android 12). -->
        <item name="android:windowSplashScreenBrandingImage" tools:targetApi="31">@drawable/splash_branding</item>
        <item name="postSplashScreenTheme">@style/Theme.GravityJelly</item>
        <item name="android:statusBarColor">@color/gj_splash_cream</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
